# ============================================================
# 医院 SPD 智能客服智能体 —— 环境配置示例
# 用法：复制本文件为 .env（同目录）后按需修改；所有项均有默认值，
#       不创建 .env 也能运行。修改后需重启后端（uvicorn）生效。
# 注意：.env 含 LLM_API_KEY 时属于敏感信息，不要提交到仓库。
# ============================================================

# ---------- 路径 ----------
# 项目根目录：由 backend/config.py 基于 Path(__file__) 自动推导
# （即本需求目录 requirements/47846874/），不支持通过 .env 修改。
#PROJECT_ROOT=<自动推导，无需填写>
# 数据目录（默认 {PROJECT_ROOT}/data，SQLite 与向量库都生成在其下）
#DATA_DIR=
# SQLite 数据库文件路径（默认 {DATA_DIR}/spd.db）
#DB_PATH=
# Chroma 向量库持久化目录（默认 {DATA_DIR}/vectorstore）
#VECTOR_DIR=
# 知识库语料目录（默认 {DATA_DIR}/docs，仅入库非 "_" 开头的 .md 文件）
#DOCS_DIR=
# 前端静态页目录（默认 {PROJECT_ROOT}/frontend，由后端托管）
#FRONTEND_DIR=

# ---------- RAG 参数 ----------
# 检索返回切片数 top-k
RAG_TOP_K=4
# 检索命中的最低相似度分数，低于该值按"知识库无相关内容"拒答（0~1，余弦相似度）
# 2026-10-25 由 0.30 上调至 0.45：实测相关问题 top1 约 0.75+，无关问题 0.30~0.38，
# 0.45 可干净分离（防语料增多后闲聊类问题不拒答）
RAG_MIN_SCORE=0.45
# 切片目标长度（字符），实际块长约 400~500 字
CHUNK_TARGET=450
# 相邻切片重叠长度（字符）
CHUNK_OVERLAP=70

# ---------- SQLite 连接加固 ----------
# 并发写等待上限（毫秒）：写冲突时等待而非立即报 database is locked
#DB_BUSY_TIMEOUT_MS=5000
# SQLite 日志模式（WAL/DELETE/TRUNCATE/PERSIST/MEMORY），留空用默认；
# 多人读写的部署可设 WAL 提升读写并发（库文件旁会多出 -wal/-shm 附属文件）
#JOURNAL_MODE=WAL

# ---------- HuggingFace ----------
# 模型下载镜像端点：国内直连 huggingface.co 常不通，默认走 hf-mirror；
# 如需直连官方改为 https://huggingface.co。config.py 会在 import
# sentence_transformers 之前把该值写入进程环境，无需手动 export。
HF_ENDPOINT=https://hf-mirror.com

# ---------- LLM 三级降级 ----------
# 第 1 级（优先）：OpenAI 兼容 HTTP API。填入 LLM_API_KEY 即启用，
# 留空则跳过该级。Key 泄露等于余额被盗，切勿提交到仓库。
LLM_API_KEY=
# 第 1 级接口地址（OpenAI 兼容，base 不含 /chat/completions）
LLM_API_BASE=https://api.deepseek.com
# 第 1 级对话模型名
LLM_MODEL=deepseek-chat

# ---------- 多外部模型通道（2026-10-25）· 主流服务商已预写好，填 KEY 即用 ----------
# 用法：LLM_CHANNELS 写通道名（逗号分隔，顺序=优先级，前者失败自动切后者），
#       每个通道补全下方 LLM_CHANNEL_<名>_BASE/_KEY/_MODEL 三项（去掉行首 #）。
# 敏感信息外发闸对全部外部通道统一生效；/api/models 可实时查看各通道状态。
#
# LLM_CHANNELS=deepseek,zhipu,qwen
#
# —— DeepSeek（深度求索）——
# LLM_CHANNEL_DEEPSEEK_BASE=https://api.deepseek.com
# LLM_CHANNEL_DEEPSEEK_KEY=
# LLM_CHANNEL_DEEPSEEK_MODEL=deepseek-chat          # 或 deepseek-reasoner（推理型）
# —— 智谱 GLM ——
# LLM_CHANNEL_ZHIPU_BASE=https://open.bigmodel.cn/api/paas/v4
# LLM_CHANNEL_ZHIPU_KEY=
# LLM_CHANNEL_ZHIPU_MODEL=glm-4.5                   # 轻量可选 glm-4-flash
# —— 通义千问（阿里云百炼，OpenAI 兼容模式）——
# LLM_CHANNEL_QWEN_BASE=https://dashscope.aliyuncs.com/compatible-api/v1
# LLM_CHANNEL_QWEN_KEY=
# LLM_CHANNEL_QWEN_MODEL=qwen-plus                  # 高性价比可选 qwen-turbo
# —— Kimi（月之暗面）——
# LLM_CHANNEL_KIMI_BASE=https://api.moonshot.cn/v1
# LLM_CHANNEL_KIMI_KEY=
# LLM_CHANNEL_KIMI_MODEL=moonshot-v1-8k             # 长文32k可选 moonshot-v1-32k
# —— 豆包（火山方舟，模型名填接入点 ID）——
# LLM_CHANNEL_DOUBAO_BASE=https://ark.cn-beijing.volces.com/api/v3
# LLM_CHANNEL_DOUBAO_KEY=
# LLM_CHANNEL_DOUBAO_MODEL=                          # 填方舟控制台的接入点 ID（ep-开头）
# —— OpenAI ——
# LLM_CHANNEL_OPENAI_BASE=https://api.openai.com/v1
# LLM_CHANNEL_OPENAI_KEY=
# LLM_CHANNEL_OPENAI_MODEL=gpt-4o-mini
# —— 自定义 OpenAI 兼容端点（vLLM / LM Studio / OneAPI 等本地网关）——
# LLM_CHANNEL_LOCAL_BASE=http://127.0.0.1:1234/v1
# LLM_CHANNEL_LOCAL_KEY=sk-local                     # 本地网关常不校验，占位即可
# LLM_CHANNEL_LOCAL_MODEL=qwen2.5-7b-instruct

# 第 2 级：本机 ollama（外部通道全不可用时自动启用）
# ollama 服务地址（服务运行在本机，默认端口 11434）
OLLAMA_BASE=http://127.0.0.1:11434
# ollama 对话模型名（需先 `ollama pull` 下载模型）
OLLAMA_MODEL=qwen2.5:7b

# 第 3 级：以上均不可用时自动降级为"仅检索"模式（mode="retrieval_only"），
# 直接返回知识库原文，无需任何配置。

# ---------- 数据安全（外发二次校验） ----------
# 发往外部大模型 API 前，对消息（问题+检索片段）做敏感信息扫描：
# 身份证号 / 手机号 / 银行卡号 / 住院·病历·就诊号；命中即拒绝外发，
# 自动降级本机 ollama 或仅检索，并记录脱敏审计日志。
# 医疗场景务必保持开启；设 0 可关闭（仅建议测试环境）。
SENSITIVE_EGRESS_BLOCK=1

# ---------- 防幻觉多重校验（生成答案三重把关） ----------
# 大模型答案返回前经三层校验（只对照本次检索原文）：忠实度（逐句依据
# 覆盖率）、引用真实性（[来源] 标注须真实命中）、数字一致性（阿拉伯
# 数字须在原文出现）。判失败的答案弃用并自动降级仅检索。
#VERIFY_ANSWER=1
# 忠实度低于 FAITH_MIN（默认 0.5）判失败降级；低于 FAITH_SUSPECT
#（默认 0.8）判疑似（返回但经 verified 字段标注）
#FAITH_MIN=0.5
#FAITH_SUSPECT=0.8
